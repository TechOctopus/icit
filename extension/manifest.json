{
  "manifest_version": 3,
  "name": "icit bridge",
  "version": "0.1.0",
  "description": "Lets a local bridge (and, through it, a phone over Bluetooth) control a tab in this browser.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "icit bridge",
    "default_popup": "popup.html"
  }
}
